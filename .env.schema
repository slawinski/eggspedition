# @defaultRequired=false
# @defaultSensitive=true
# @generateTypes(lang='ts', path='env.d.ts')
# ---

# App environment
# @type=enum(development, staging, production)
# @sensitive=false
NODE_ENV=development

# Database connection URL
# @type=url
DATABASE_URL=

# SMTP configuration for sending magic links (Gmail)
# @type=string
SMTP_HOST=smtp.gmail.com

# @type=string
SMTP_PORT=587

# @type=string
SMTP_USER=

# @type=string
SMTP_PASS=

# @type=string
EMAIL_FROM=Eggspedition <noreply@example.com>

# Secret for signing auth tokens (JWT/Session)
# @type=string(minLength=32)
AUTH_SECRET=

# Exact authentication/WebAuthn origin and RP hostname. Keep hostname stable:
# changing it invalidates existing passkeys. HTTPS required; HTTP localhost only
# outside production. Runtime authOrigin() enforces this in addition to URL syntax.
# @type=url
# @sensitive=false
BASE_URL=http://localhost:3000

# Comma-separated list of allowed login emails (whitelist)
# @type=string
AUTH_WHITELIST=

# Shared passphrase for login (both users share this)
# @type=string
AUTH_PASSPHRASE=
